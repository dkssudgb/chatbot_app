# API KEY
GOOGLE_API_KEY=

# LLM (비워두면 gemini-3.1-flash-lite 사용)
# 예: GEMINI_MODEL=gemini-3.8-flash
GEMINI_MODEL=

# DB (비워두면 db/members.db 샘플 SQLite DB를 읽기 전용으로 사용)
# 예: DATABASE_URL=sqlite:////absolute/path/to/members.db
# 예: DATABASE_URL=mysql+mysqlconnector://user:password@host:3306/database
DATABASE_URL=
